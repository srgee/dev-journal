#!/usr/bin/env bash

# Verify Betterleaks is installed
if ! command -v betterleaks &> /dev/null; then
    echo "Betterleaks is not installed."
    echo "Please install Betterleaks before committing."
    exit 1
fi

echo "Running Betterleaks scan..."

betterleaks git . \
    --staged \
    --config .betterleaks.toml

EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "Secrets detected."
    echo "Commit blocked."
    exit 1
fi

echo "No secrets found."
exit 0